# Copy to .env.local for real dev values. Names only here — see
# CLAUDE.md "Source control" (never commit real values).

# Local Postgres. .env.test overrides only DATABASE_URL/DIRECT_URL, first-wins
# via `dotenv -e .env.test -e .env.local`.
DATABASE_URL=
DIRECT_URL=

# This repo owns 3400 (storage 3000, rental 3100, bookable 3300). The value is
# also the config default in apps/web/package.json and playwright.config.ts —
# a forgotten env var cannot hijack a neighbour's port.
PORT=3400

# The kitchen's shared staff passcode (C-037). Names only here — set a real one
# in .env.local / .env.test and in the deployment's environment. UNSET MEANS
# LOCKED: /kitchen refuses everyone rather than falling back to a default, so a
# deploy that forgets this loses the queue screen instead of publishing it.
# Rotating the value signs every device out; there is no session table.
STAFF_PASSCODE=
