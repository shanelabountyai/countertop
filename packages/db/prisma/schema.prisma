// Countertop — the data model (C-003).
//
// NORMATIVE: PRD P0-3, P0-4, P0-8, P0-9, P0-10 and CLAUDE.md "Database rules".
//
// THE RULE THIS FILE EXISTS TO ENFORCE:
//
//   A placed order is an immutable COPY of everything it was composed from.
//   Order/OrderLine/OrderLineOption carry copied names and computed prices as
//   COLUMNS. A receipt renders with ZERO joins to Category, MenuItem,
//   ModifierGroup or ModifierOption. If an order row ever joins a menu table
//   to render or to do money math, that is the defect.
//
//   The `menuItemId` / `modifierGroupId` / `modifierOptionId` columns on the
//   snapshot tables are PLAIN STRINGS with no foreign key (decided C-003).
//   They exist for analytics correlation only and are never read for display
//   or pricing. No FK, deliberately: a manager must be able to delete a
//   discontinued item, and `onDelete: Restrict` would forbid that forever
//   while `SetNull` would MUTATE a placed order — which is the one thing this
//   whole model refuses to allow.
//
// OTHER RULES:
//   * Money is integer cents. Never a float, never a Decimal that becomes one.
//     `taxRatePpm` is snapshotted alongside the money, or a later rate change
//     makes an old receipt arithmetically unexplainable.
//   * `@db.Date` is BANNED. `businessDay` is `String @db.Char(10)` holding a
//     restaurant-timezone calendar day. Postgres `date` -> JS `Date` is the
//     exact path that produced a sibling build's silent day-west shift with
//     every test green.
//   * Instants are `@db.Timestamptz(3)`.
//   * There is no cart table (decided C-003): the cart is client-side and the
//     server validates and prices it on every mutation. Cart tables would
//     mirror OrderLine field for field and need their own expiry job.
//
// WHAT PRISMA CANNOT EXPRESS, AND SO LIVES IN THE HAND-WRITTEN MIGRATION:
//   1. The `order_event_append_only` BEFORE UPDATE OR DELETE trigger on
//      OrderEvent. Undo writes a logged revert event; it never deletes.
//   2. The `restaurant_settings_singleton` CHECK — one settings row, ever.
//
// NEVER `prisma db push`. Never edit an applied migration.
// (`prisma migrate dev --create-only`, then edit.)

generator client {
  provider = "prisma-client-js"
  // NO custom `output` (was `../generated/client` until C-045).
  //
  // A client generated outside node_modules is imported by RELATIVE PATH, and
  // a relative path cannot be named in Next's `serverExternalPackages`. So
  // Turbopack bundled the client, the bundled client set `isBundled = true`,
  // and Prisma's engine lookup — which resolves the `.so` from the module's
  // own directory — had no directory to resolve from. Every query on the
  // deployment died with "could not locate the Query Engine", while every
  // local build stayed green: nothing is bundled when `next dev` and the e2e
  // production build both run beside the file.
  //
  // The default location makes the client `@prisma/client`, an ordinary
  // package name, which apps/web/next.config.ts marks external.
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// C-004 owns the transitions. This enum is the persisted vocabulary; the ONE
/// status module in packages/core is the authority on what may follow what,
/// and C-004 adds the test asserting the two lists agree.
enum OrderStatus {
  placed
  accepted
  preparing
  ready
  picked_up
  cancelled
  abandoned
}

/// `none` is the NEGATION — "NO onions" — and it is why this column exists at
/// all: the kitchen card must render a removal differently from an addition.
enum Intensity {
  none
  light
  regular
  extra
}

enum PaymentState {
  unpaid
  paid
  refunded
  /// PRD 3 P1-1 (C-069): the card is held and nothing has been taken.
  ///
  /// The value the enum could never say, and the one a pickup-only shop needs
  /// most: between checkout and the counter the restaurant has a promise, not
  /// money. Spelling that `paid` told the customer their card had been charged
  /// before it had, and made a no-show cost a refund instead of a void.
  ///
  /// AT THE END, like every other value added since C-063: the vocabulary test
  /// compares `PAYMENT_STATES` against `pg_enum` position for position, and
  /// `ALTER TYPE ... ADD VALUE` appends.
  authorized
}

enum CancelReason {
  out_of_item
  too_busy
  // C-057. The two the operator names most and could count least — both were
  // being typed into `other`'s free text. Declared BEFORE `other` so the
  // enum's sort order matches `CANCEL_REASONS`, which the vocabulary test
  // compares position for position.
  customer_changed_mind
  kitchen_error
  other
}

enum EventActor {
  customer
  staff
  system
}

enum OrderEventKind {
  /// A forward move. `placed` itself is a transition from nothing.
  transition
  /// A backward move, always deliberate and always logged. Never a delete.
  revert
  /// P0-2: what the client claimed vs. what the server computed.
  total_mismatch
  /// P0-4: money going back — and after C-067 it MEANS the money went back.
  /// Written only once the provider has said yes, outside the status
  /// transaction, so a refund row is evidence rather than an intention.
  refund
  /// PRD 3 P0-4 (C-067): the restaurant owes this money back and has not sent
  /// it yet. Written inside the cancellation — deciding to refund is part of
  /// cancelling a paid order — while the attempt that follows is a separate
  /// fact and a separate write, because they are not one fact and must not be
  /// one atomic write.
  ///
  /// Its own row `id` is the refund's idempotency key: every attempt against
  /// this request carries it to the provider, so a retry after a lost response
  /// cannot pay the customer twice. The unique constraint behind it is the
  /// primary key, which is the cheapest true one available.
  ///
  /// Carries NO amount. What is refundable is what the restaurant is holding,
  /// recomputed by `orderBalance` at the moment of each attempt — an amount
  /// frozen here is one a later comp or payment can make wrong.
  refund_requested
  /// PRD 3 P0-4 (C-067): we tried and the provider refused. The state
  /// `PaymentState` cannot hold — its three values are terminal facts and none
  /// of them is "we tried". Carries no amount because nothing moved; the
  /// provider's own words go in `detail.note`, which `readNote` already lifts
  /// onto the receipt. A retry appends another one of these, or a `refund`.
  refund_failed
  /// PRD 6 P0-3 (C-085): money arriving, with its instant and its amount. The
  /// mirror of `refund`. Before it, an order collected at the counter had a
  /// `paymentState` of `paid` and nothing anywhere saying when.
  payment
  /// PRD 3 P0-3 (C-065): money the restaurant chose not to ask for — a comp or
  /// a partial write-off. Decision 6 of 2026-09-01: a record of a decision the
  /// counter made, not a charge. It NEVER updates `subtotalCents`, `taxCents`
  /// or `totalCents` — the balance is a computation beside the snapshot, and
  /// the obvious "subtract it from the total" version is refused because it
  /// mutates a write-once column.
  adjustment
  /// PRD 3 P0-3 (C-066): this order replaces the one named by
  /// `relatedOrderId`. Decision 7 of 2026-09-02 — a remake is a REAL second
  /// order with its own number and its own ticket, because the kitchen has to
  /// cook something and a remake nobody is told to make is the transcription
  /// failure this product exists to kill. Carries NO amount: the money is the
  /// full comp written beside it, so this kind stays on the "must not" side of
  /// `order_event_amount_matches_kind` without that constraint changing.
  remake
  /// PRD 2 P0-6 (C-092): somebody wrote on the ticket. The text is
  /// `detail.note`, the instant is `at` and who wrote it is `staffId` — no new
  /// column anywhere, because the log is the only shape that holds the
  /// requirement: a note NEVER overwrites the note before it, and a column
  /// would hold exactly one. Carries no amount, so it stays on the "must not"
  /// side of `order_event_amount_matches_kind` with that constraint untouched.
  ///
  /// NEVER reaches the customer, and not by anybody remembering: `ORDER_RECEIPT`
  /// selects `{ kind, amountCents }` off the event log, so the shape behind
  /// `/status/[token]` has no `detail` to render — the same structural refusal
  /// `omit: { shelfLocation: true }` makes one requirement above this one.
  note
  /// PRD 3 P0-6 (C-071): an adjustment taken back. The counter comped the
  /// wrong ticket, and the correction is a CONTRADICTING ROW rather than a
  /// delete — the append-only trigger means that is not a preference, and a
  /// comp that vanishes is a comp nobody can be asked about at close.
  ///
  /// Its own kind rather than a negative `adjustment`, because `amountCents`
  /// is unsigned and `order_event_amount_is_positive` says so: direction has
  /// been the kind since C-063. `paymentTotals` subtracts these out of
  /// `adjustedCents`, which is the whole of its effect — the money owed comes
  /// back and both decisions stay legible side by side.
  ///
  /// AT THE END, and the position is load-bearing rather than tidy: the
  /// vocabulary test in `snapshot.test.ts` compares `ORDER_EVENT_KINDS`
  /// against `pg_enum` position for position, and `ALTER TYPE ... ADD VALUE`
  /// appends.
  adjustment_reversed
  /// PRD 3 P1-1 (C-069): a hold on the customer's card, taken at checkout.
  ///
  /// NOT money. Its own row `id` is the idempotency key every settlement
  /// against it carries to the provider — the same trick `refund_requested`
  /// plays, and the reason neither needs a second unique column.
  ///
  /// Carries the amount held, so `paymentTotals` can answer "is anything owed
  /// at the counter" by arithmetic rather than by following the link. Nothing
  /// moved, and `adjustment` set the precedent for an amount-bearing kind that
  /// moved nothing.
  authorization
  /// PRD 3 P1-1 (C-069): the hold, taken, on `ready -> picked_up`.
  ///
  /// Money arriving exactly as `payment` is — `paymentTotals` sums the two
  /// together — and its own kind because it SETTLES an authorization, which a
  /// `payment` row has no column to say. Names its hold in `authorizationId`,
  /// and the unique index there is what stops a revert-and-re-advance charging
  /// the same card twice.
  capture
  /// PRD 3 P1-1 (C-069): the hold, released. THE POINT OF THE ITEM — a no-show
  /// costs a void, not a refund, because nothing ever left the card.
  ///
  /// `reason` says which of three: `no_show`, `cancelled`, or `capture_failed`
  /// (the honest name for a hold that could not be turned into money, which
  /// puts the order back to owing at the counter where the existing control
  /// already is). Carries the amount released, for the arithmetic above.
  ///
  /// AT THE END, and the position is load-bearing rather than tidy: the
  /// vocabulary test compares `ORDER_EVENT_KINDS` against `pg_enum` position
  /// for position, and `ALTER TYPE ... ADD VALUE` appends.
  authorization_voided
}

// ---------------------------------------------------------------------------
// Menu — live, editable, and never read by a placed order
// ---------------------------------------------------------------------------

model Category {
  id        String     @id @default(uuid())
  name      String
  sortOrder Int
  items     MenuItem[]

  @@index([sortOrder])
}

model MenuItem {
  id             String              @id @default(uuid())
  categoryId     String
  category       Category            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name           String
  description    String?
  basePriceCents Int
  /// The item grain of 86'ing (P0-6). Unavailable items render "sold out",
  /// they are not hidden.
  available      Boolean             @default(true)
  // NOT PRESENT, deliberately: `taxCategory` is step M1 of the deferred
  // per-line tax plan above `model OrderLine` (C-070). Bottled water and
  // Mexican Coke are on this menu today at the prepared-food rate. Plain `//`
  // rather than `///`: a doc comment would attach itself to `prepWeight`.
  /// Kitchen work, not price (P1-7). The P0-6 auto-pause threshold and the
  /// P0-7 estimate sum this across open orders instead of counting them. 0 is
  /// legal — a bottle out of the fridge is no work.
  prepWeight     Int                 @default(1)
  sortOrder      Int
  modifierGroups ItemModifierGroup[]
  /// When this item is served (P1-1). No rows = all day, every day.
  windows        MenuItemWindow[]
  /// Price changes queued for a future day (P1-2). No rows = the price is
  /// whatever `basePriceCents` says, which is what almost every item is.
  stagedPrices   StagedPrice[]

  @@index([categoryId, sortOrder])
}

/// One window an item is served in (P1-1) — the 4pm lunch-to-dinner
/// changeover, done by the clock instead of by a manager 86'ing eleven items
/// from a phone.
///
/// A CHILD TABLE, not a column pair on `MenuItem`, because an item can be
/// served in more than one window on a day (breakfast and dinner, nothing in
/// between). That is the difference from `StoreHours`, where `dayOfWeek` is
/// the primary key because C-011 deliberately foreclosed split opening hours:
/// these are two different gates and must not be conflated.
///
/// And deliberately NOT a boolean on `MenuItem` beside `available`: an 86 is a
/// human fact that C-012 decided never restores itself overnight, and a
/// schedule that restores things by design would silently un-86 what a cook
/// killed at 12:40. Separate columns is what keeps that decision true.
model MenuItemWindow {
  id          String   @id @default(uuid())
  itemId      String
  /// Cascade, unlike the snapshot tables' `Restrict`: a window is not a record
  /// of anything that happened, it is a property of a live menu row, and one
  /// without its item means nothing.
  item        MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 0 = Sunday, matching `restaurantClock` and `StoreHours`.
  dayOfWeek   Int
  /// Local wall-clock minutes since midnight, 0–1439. Inclusive.
  startMinute Int
  /// Local wall-clock minutes since midnight, 1–1440. Exclusive, so abutting
  /// windows do not both own the changeover minute.
  endMinute   Int

  /// Two windows on the same day may not start at the same minute — that is
  /// either a duplicate or a contradiction, and both would make the answer
  /// depend on row order.
  @@unique([itemId, dayOfWeek, startMinute])
  @@index([itemId])
}

model ModifierGroup {
  id               String              @id @default(uuid())
  name             String
  /// `min > 0` IS what "required" means. There is deliberately no separate
  /// flag to contradict it (decided C-002).
  min              Int
  max              Int
  intensityEnabled Boolean             @default(false)
  options          ModifierOption[]
  items            ItemModifierGroup[]
}

model ModifierOption {
  id                   String        @id @default(uuid())
  groupId              String
  group                ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name                 String
  /// May be negative or zero.
  priceDeltaCents      Int
  /// Surcharge on top of the delta when taken at `extra`. Null means free.
  extraPriceDeltaCents Int?
  /// The option grain of 86'ing: out of avocado is not out of burritos.
  available            Boolean       @default(true)
  sortOrder            Int
  /// Price changes queued for a future day (P1-2).
  stagedPrices         StagedPrice[]

  @@index([groupId, sortOrder])
}

/// A price change staged to take effect on a future day (P1-2) — Monday's
/// increase, typed on Sunday, instead of typed during Monday's lunch.
///
/// A CHILD TABLE, not a `stagedPriceCents`/`stagedFrom` column pair, because
/// more than one change can be queued: a Monday increase and a holiday price
/// two weeks later are both real and neither should have to wait for the
/// other to land before it can be written down.
///
/// A restaurant-calendar DAY, not an instant. "Effective Monday" is a
/// calendar question and the calendar that answers it is the restaurant's —
/// the same reason `Order.businessDay` is a string and not a `timestamptz`.
/// It also keeps this table out of the local → instant direction
/// `business-day.ts` deliberately refuses to go: 2:30am on a DST Sunday is
/// two instants or none, and a price is not worth a second answer to that.
/// The ceiling is that a change lands at local midnight and nowhere else;
/// docs/WRITEUP.md records it.
///
/// The live column stays the live price. A staged row OVERRIDES it once its
/// day arrives, and a manager typing a price today deletes the spent rows
/// that would otherwise keep overriding what they just typed — that
/// precedence is the whole of it and `menu.test.ts` asserts it.
model StagedPrice {
  id           String          @id @default(uuid())
  /// EXACTLY ONE of these is set — `staged_price_one_target` is the CHECK
  /// that says so. One table rather than two because there is one resolution
  /// rule, and two tables would be two places to get it wrong.
  itemId       String?
  /// Cascade, like a daypart window and unlike a snapshot row: a queued price
  /// for an item that no longer exists is not a record of anything.
  item         MenuItem?       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  optionId     String?
  option       ModifierOption? @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /// Restaurant-timezone calendar day, "YYYY-MM-DD". Never a Postgres `date`,
  /// which round-trips through JS as an instant and shifts a day west.
  effectiveDay String          @db.Char(10)
  /// Integer cents, like every other price. Non-negative for an ITEM; an
  /// option's delta may be a discount, so the CHECK is conditional.
  priceCents   Int

  /// Two prices for the same row on the same day is a contradiction whose
  /// answer would depend on row order — the same rule `MenuItemWindow` makes
  /// about two windows starting at the same minute. NULLs are distinct in a
  /// Postgres unique index, so the item rows and the option rows do not
  /// collide on each other's constraint.
  @@unique([itemId, effectiveDay])
  @@unique([optionId, effectiveDay])
  @@index([effectiveDay])
}

/// The join that makes group REUSE real: one "salsa" group serves the burrito
/// and the bowl, with nothing duplicated to drift apart (P0-1).
model ItemModifierGroup {
  itemId    String
  groupId   String
  sortOrder Int
  item      MenuItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting a group used by other items is exactly
  /// the destructive edit P0-13 makes a manager confirm first.
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([itemId, groupId])
  @@index([itemId, sortOrder])
}

// ---------------------------------------------------------------------------
// Order — the snapshot. Every column below is a copy or a computed value.
// ---------------------------------------------------------------------------

model Order {
  /// Internal only. The UUID never appears in any UI (P0-8) — customers and
  /// staff use `seq` + `customerName`.
  id              String        @id @default(uuid())
  /// Restaurant-timezone calendar day, "YYYY-MM-DD". Never a Postgres `date`.
  businessDay     String        @db.Char(10)
  /// The human-callable number: #047. Resets daily, per business day.
  seq             Int
  customerName    String        @db.VarChar(40)
  customerPhone   String?       @db.VarChar(32)
  orderNote       String?       @db.VarChar(140)
  status          OrderStatus
  /// Orders the kitchen queue.
  placedAt        DateTime      @db.Timestamptz(3)
  /// Drives both aging flags (the 15-minute queue flag and the 10/20/30-minute
  /// `ready` no-show flag). Every OTHER transition time is derived from the
  /// append-only event log, which is the single source — a denormalized column
  /// per status can disagree with it, and a logged revert would have to decide
  /// whether to un-set one (decided C-003).
  statusChangedAt DateTime      @db.Timestamptz(3)
  subtotalCents   Int
  taxCents        Int
  /// Snapshotted with the money. A later rate change must not make this
  /// receipt's arithmetic unexplainable.
  ///
  /// ONE rate over the whole subtotal — see "PER-LINE TAX, THE MIGRATION NOT
  /// TAKEN" above `model OrderLine`. On a menu with bottled drinks and bagged
  /// chips that is legally the wrong number in most US states, and it is
  /// deferred rather than unnoticed (C-070). This column keeps its meaning
  /// under that plan and is never dropped.
  taxRatePpm      Int
  totalCents      Int
  /// Snapshotted with the money (P1-7): the sum of each line's item weight
  /// times its quantity, as the menu read at placement. Re-deriving it through
  /// `menuItemId` would let re-weighting an item change how heavy a queue that
  /// has already been cooked was.
  prepWeight      Int
  /// What this order was PROMISED at placement (P1-4), snapshotted like the
  /// money and for the same reason: recomputing an old order's estimate from
  /// today's settings grades this afternoon's arithmetic against itself and
  /// always scores full marks. Nullable because orders placed before C-042
  /// were never told anything — a backfill would be inventing a promise, and
  /// "no record" is the honest value.
  quotedLowMinutes  Int?
  quotedHighMinutes Int?
  /// The open prep weight the quote was computed against — the queue that was
  /// in front of this order. Without it the report can prove the quotes are
  /// wrong but not WHICH of the two P0-7 settings is wrong.
  quotedOpenWeight  Int?
  /// WHERE THE BAG IS, RIGHT NOW (PRD 2 P0-5) — and the one mutable column on
  /// this table that is deliberately outside the snapshot.
  ///
  /// Every other field here answers "what was sold": copied at placement,
  /// write-once, and provably unmoved by a later menu edit. This one answers
  /// "where is the food" — written after placement on the tap that marks the
  /// order ready, edited freely afterwards because a bag gets moved, and
  /// meaningless the moment the order is collected.
  ///
  /// What keeps the tension honest is that it is unreachable from every
  /// snapshot reader rather than merely unused by them: `ORDER_RECEIPT` omits
  /// it, so the customer's status page, the staff receipt and placement cannot
  /// render it even by accident, and the queue read is the only shape that
  /// carries it. No report reads it, and no price is computed from it.
  shelfLocation   String?       @db.VarChar(16)
  paymentState    PaymentState  @default(unpaid)
  cancelReason    CancelReason?
  cancelNote      String?       @db.VarChar(140)
  /// The customer's status link (>=128 bits of randomness). Unguessable, so
  /// enumerating order numbers cannot reach someone else's order.
  statusToken     String        @unique
  /// P0-10. The CONSTRAINT is the mechanism; the disabled submit button is UX.
  idempotencyKey  String        @unique
  lines           OrderLine[]
  events          OrderEvent[]
  /// Events on OTHER orders that point at this one (C-066). In practice: the
  /// `remake` event on the order that replaced this one. `Restrict` on the far
  /// side, so the link between a wrong order and its remake cannot be tidied
  /// away — it is the only record that either happened.
  remadeBy        OrderEvent[] @relation("OrderRemake")
  /// Ledger rows earned or redeemed against this order (PRD 7). `Restrict` on
  /// the far side: the order outlives them. `Order` itself gains NO column and
  /// NO foreign key to any loyalty table — P0-6 states that as a requirement
  /// rather than an omission, because a member FK here would make the forget
  /// either cascade (changing a report count) or restrict (blocking it).
  loyaltyEvents   LoyaltyEvent[]

  /// Two concurrent placements contend HERE, on the constraint — never on a
  /// check-then-write. The loser catches the violation and retries at seq+1.
  @@unique([businessDay, seq])
  /// The kitchen queue read: group by state, order by placement time.
  @@index([status, placedAt])
}

// ---------------------------------------------------------------------------
// PER-LINE TAX — THE MIGRATION NOT TAKEN (C-070, PRD 3 P1-2, decision 11).
//
// NORMATIVE. This block is the deliverable of C-070: the gating Open Question
// was answered "not now", and the item is this plan rather than the columns.
// A later session that decides to build it starts here and does not re-derive
// the order.
//
// THE DEFECT BEING DEFERRED, STATED HONESTLY:
//   Tax is ONE flat rate over the whole subtotal — `taxOn(subtotalCents,
//   ratePpm)` in packages/core/pricing, one rounding, snapshotted per order as
//   `Order.taxRatePpm`. The seeded menu already contains `Bottled water`,
//   `Mexican Coke` and `Chips & salsa`, which in most US states are taxed
//   differently from the burrito beside them. So this is not a rate that is
//   merely simplified: on a real menu in a real state it is arithmetically the
//   wrong number. What makes it shippable anyway is that it is EXPLAINABLE —
//   the rate that produced every stored `taxCents` is stored beside it.
//
// WHY IT IS NOT BUILT: THE BACKFILL HAS NO DEFENSIBLE ANSWER.
//   1. `OrderLine` is a snapshot table. The one precedent for UPDATEing one is
//      C-091's retention sweep, and what made that legal was narrow and was
//      stated: it touches only columns that are WHO ORDERED, never columns
//      that are WHAT WAS SOLD. Per-line tax is entirely the second kind.
//   2. Even setting the invariant aside, there is no input to backfill FROM.
//      An order placed in March stored one `taxCents` for the whole ticket at
//      one rate. Splitting it per line needs today's `taxCategory` assignments,
//      which did not exist in March — and re-rounding per line does not
//      reproduce the order's own total, because round-then-sum is not
//      sum-then-round. The output is a restated filed period whose new figure
//      ties to no receipt any customer holds.
//   Therefore: NULLABLE COLUMNS, NO BACKFILL, FOREVER. `null` is the honest
//   answer and means "placed before per-line tax; `Order.taxCents` is the
//   whole truth about this order". No reader may apportion the order-level
//   figure across lines to fill it in — that is inventing a number.
//
// THE COLUMNS, IN THE ORDER THEY MOVE. Each step is arithmetically inert on
// its own; only step 4 changes a number, and only for orders placed after it.
//
//   M1. `enum TaxCategory { prepared grocery exempt }` and
//       `MenuItem.taxCategory TaxCategory @default(prepared)`.
//       The default IS the current behaviour, so the backfill is the default
//       and there is nothing to decide. One file — creating the type and a
//       column using it is legal together. A LATER category is two files:
//       `ALTER TYPE ... ADD VALUE` cannot be used in the transaction that adds
//       it (the split C-065, C-071 and C-069 each needed).
//
//   M2. `model TaxRate { category TaxCategory @id, ratePpm Int }`, seeded with
//       today's `RestaurantSettings.taxRatePpm` for every category — so M2
//       also changes no number. Rows rather than three columns on the
//       singleton, because a fourth category must not be a schema change on a
//       table carrying a CHECK.
//       `RestaurantSettings.taxRatePpm` IS NOT DROPPED. Ever. It is what every
//       order placed before M3 is explained by, and the tidy-up migration that
//       drops it is where old receipts silently become unexplainable.
//
//   M3. `OrderLine.taxCategory TaxCategory?`, `OrderLine.taxRatePpm Int?`,
//       `OrderLine.taxCents Int?`. No default, no backfill (see above).
//       The CATEGORY is snapshotted on the LINE, not chased through
//       `menuItemId` — reclassifying Mexican Coke from prepared to grocery
//       next year must not change what a line placed today was taxed as. This
//       is the snapshot rule arriving at tax, and it is the column a
//       normalising instinct will try to delete.
//
//   M4. No migration — the engine, and the only step that changes a number.
//       `taxOn` is UNCHANGED and stays the one rounding function; it is called
//       once per line instead of once per order, and `Order.taxCents` becomes
//       the sum of its lines. `buildOrderSnapshot` and `reviewCart` in
//       packages/db/placement.ts are the two call sites.
//       `Order.taxRatePpm` stops explaining the total on its own the moment an
//       order spans two categories; its comment must say so, and it is written
//       as the `prepared` rate.
//       THE TEST THAT MUST EXIST BEFORE THIS LANDS: a two-line order across
//       two rates whose per-line rounding and whole-subtotal rounding differ,
//       asserted at the cent. If those two numbers cannot be made to differ in
//       a fixture, the fixture is wrong, not the engine.
//
//   M5. The readers. Every surface renders `Order.taxCents` today and goes on
//       doing so — the report, the CSV, both receipts. The new question, "what
//       tax did THIS LINE pay", has exactly one honest answer: the line's own
//       columns, or `null`.
//
// WHAT WOULD TRIGGER BUILDING IT: a second jurisdiction, a filing export with
// a real consumer, or this shop actually being in a state where the drinks and
// chips already on its menu are exempt. None of the three exists today, and
// the half-built version — columns populated forward only, with no screen
// admitting that two eras of orders answer the same question differently — is
// worse than either end.
// ---------------------------------------------------------------------------

model OrderLine {
  id             String            @id @default(uuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lineNumber     Int
  /// Analytics correlation only. No FK, never read for display or pricing.
  menuItemId     String?
  /// --- copied at placement ---
  itemName       String
  categoryName   String
  basePriceCents Int
  quantity       Int
  /// --- computed at placement: (base + sum of applied deltas) ---
  unitPriceCents Int
  /// --- computed at placement: unitPriceCents * quantity ---
  lineTotalCents Int
  note           String?           @db.VarChar(140)
  options        OrderLineOption[]

  /// A card that renders its lines in a different order on each poll is a card
  /// a cook misreads.
  @@unique([orderId, lineNumber])
}

model OrderLineOption {
  id                String     @id @default(uuid())
  orderLineId       String
  line              OrderLine  @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  sortOrder         Int
  /// Analytics correlation only. No FK, never read for display or pricing.
  modifierGroupId   String?
  modifierOptionId  String?
  /// --- copied at placement ---
  groupName         String
  optionName        String
  /// Null in a group without intensity. `none` is the negation the kitchen
  /// card must render distinctly.
  intensity         Intensity?
  /// What this option actually added to the unit price: 0 for a negation,
  /// delta + extra surcharge at `extra`. The options sum exactly to
  /// OrderLine.unitPriceCents minus basePriceCents.
  appliedDeltaCents Int

  @@unique([orderLineId, sortOrder])
}

/// Append-only, enforced by a trigger in the migration. An undo writes a
/// `revert` row; nothing is ever deleted or updated.
model OrderEvent {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  at         DateTime       @db.Timestamptz(3)
  kind       OrderEventKind
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  /// WHAT KIND of actor. Unchanged, and it keeps its meaning.
  actor      EventActor
  /// WHICH ONE (PRD 6 P0-2). The two columns answer different questions and
  /// neither replaces the other: `actor` stays the thing the engine decides,
  /// this is the thing the shift knows.
  ///
  /// Nullable, and NEVER backfilled. An event written before C-086 is honestly
  /// unattributed; guessing a name for it would put a person's name on a row
  /// they may not have written, which is worse than a null in every direction
  /// that matters. Null on `customer` and `system` events by construction.
  ///
  /// `Restrict`, like the analytics FKs: attribution must not disappear
  /// because somebody tidied up a staff list.
  staffId    String?
  staff      StaffMember?   @relation(fields: [staffId], references: [id], onDelete: Restrict)
  reason     String?
  /// Money moved by THIS event, in integer cents (PRD 3 P0-1, C-063).
  ///
  /// A column and not a key in `detail`, because the event stream is now the
  /// truth about payment (decision 5, 2026-09-01) and a balance summed out of
  /// JSON is a balance no index can help and no CHECK can constrain. A CHECK
  /// ties it to the kinds that move money: `payment` and `refund` must carry
  /// one, everything else must not.
  amountCents Int?
  /// The processor's own reference for this movement, for the day there is a
  /// processor. Null throughout — `provider: 'mock'` in `detail` is the honest
  /// record that no call was made — and here now because adding it later means
  /// a migration over a table that only grows.
  providerRef String?        @db.VarChar(128)
  /// The order this event points AT (C-066). Non-null only on `remake` today.
  ///
  /// ONE DIRECTION: the remake's own event names the original, and the
  /// original's receipt finds its remake by reverse lookup off the index
  /// below. Recording it on both orders would be one fact stored twice, and
  /// two copies of a fact are two things that can disagree.
  relatedOrderId String?
  relatedOrder   Order?       @relation("OrderRemake", fields: [relatedOrderId], references: [id], onDelete: Restrict)
  /// The refund REQUEST this attempt was made against (PRD 3 P0-6, C-071).
  ///
  /// Non-null on `refund` and `refund_failed`, null on everything else, and
  /// `order_event_refund_link_matches_kind` says the second half. It is what
  /// makes MORE THAN ONE refund per order answerable: until C-071 the only
  /// thing that could ask for one was cancelling a paid order, so there was
  /// exactly one request and "did the refund land" was a question about the
  /// ORDER. A deliberate refund can be issued again for another part of the
  /// balance, and without this link the second request would read as settled
  /// by the first one's success.
  ///
  /// The value is the request row's own id, which is ALSO the idempotency key
  /// the provider is handed. One value doing two jobs rather than a second
  /// column to keep true — the same argument `refund_requested` makes above.
  ///
  /// `Restrict`, like the analytics FKs: a request must not be deleted out
  /// from under the attempts that name it. The append-only trigger already
  /// refuses every delete on this table, so this is the constraint saying the
  /// same thing where a future migration can see it.
  refundRequestId String?
  refundRequest   OrderEvent?  @relation("RefundAttempt", fields: [refundRequestId], references: [id], onDelete: Restrict)
  /// The attempts made against this request — the reverse of the link above,
  /// and what `loadRefundExceptions` asks: a request with `none` of these of
  /// kind `refund` is money owed and unsent.
  refundAttempts  OrderEvent[] @relation("RefundAttempt")
  /// The AUTHORIZATION this event settles (PRD 3 P1-1, C-069).
  ///
  /// Non-null on `capture` and `authorization_voided`, null on everything
  /// else, and `order_event_authorization_link_matches_kind` says the second
  /// half. The value is the hold's own row id, which is ALSO the idempotency
  /// key the provider is handed — one value doing two jobs, the same argument
  /// `refundRequestId` makes above.
  ///
  /// `@unique` AND NOT AN INDEX, which is the whole guard: a hold has exactly
  /// one exit, so at most one row may name it, and a captured authorization
  /// cannot also be voided. The refund's equivalent has to be a partial index
  /// because a request may fail many times before it succeeds; a capture that
  /// fails releases the hold instead of retrying it, so there is nothing to
  /// leave room for. Prisma can express this one, so it lives in the schema
  /// rather than in the migration, and `prisma migrate diff` sees it.
  ///
  /// `Restrict`, like the other self-link: the append-only trigger already
  /// refuses every delete on this table, and this says the same thing where a
  /// future migration can see it.
  authorizationId String?      @unique
  authorization   OrderEvent?  @relation("AuthorizationSettlement", fields: [authorizationId], references: [id], onDelete: Restrict)
  /// The one row that settled this hold — captured or released. The reverse of
  /// the link above, and a `?` rather than a `[]` because the unique constraint
  /// makes it at most one.
  settlement      OrderEvent?  @relation("AuthorizationSettlement")
  detail     Json?

  @@index([orderId, at])
  /// Postgres does not index a foreign key for you, and `Restrict` scans this
  /// column on every attempted delete. It is also what "what did Sam do on
  /// Friday?" reads.
  @@index([staffId])
  /// Postgres does not index a foreign key for you, and `Restrict` scans this
  /// on every attempted delete. It is also the reverse lookup a receipt does
  /// to find the order that replaced it.
  @@index([relatedOrderId])
  /// Postgres does not index a foreign key for you, and `Restrict` scans this
  /// on every attempted delete. It is also what the exceptions list reads:
  /// "which requests have no `refund` against them".
  ///
  /// A PARTIAL UNIQUE index enforcing at most one settled `refund` per request
  /// lives beside it, in the migration only — Prisma cannot express a `WHERE`
  /// on an index, so `prisma migrate diff` ignores it exactly as it ignores
  /// the CHECK constraints, and CI asserts it by name in `pg_class` for the
  /// same reason it asserts those.
  @@index([refundRequestId])
}

/// A name to put on a row (PRD 6 P0-2). NOT an account.
///
/// There are no roles, no permissions and no per-person login: the shared
/// passcode (C-037) is still the only authentication boundary, and everyone
/// behind it sees the same buttons. This table exists so the append-only log
/// can say WHO, which it could not — every staff-written event since C-004
/// says `actor: 'staff'` and nothing else, and no backfill can invent the
/// names now.
model StaffMember {
  id        String       @id @default(uuid())
  /// What appears on the row. Unique because two people called Sam is a naming
  /// problem for the restaurant to solve at the point of hiring, not an
  /// ambiguity a permanent log should carry.
  name      String       @unique @db.VarChar(40)
  /// SHA-256 of the salted PIN, hex. Unique, so two people cannot pick the
  /// same four digits and make every event they write ambiguous.
  ///
  /// A four-digit PIN behind a shared passcode is a STAMP, not a credential —
  /// 10,000 possibilities is not a security boundary and this schema does not
  /// pretend otherwise. Whoever can type a PIN is already inside.
  pinDigest String       @unique
  /// Someone who leaves is deactivated, never deleted: their name stays on
  /// every row they wrote.
  active    Boolean      @default(true)
  createdAt DateTime     @db.Timestamptz(3)
  events    OrderEvent[]
  /// Corrections this person made to a loyalty balance (PRD 7 P0-2).
  /// `Restrict`, like every other attribution: a name outlives the rows it is
  /// on.
  loyaltyEvents LoyaltyEvent[]
}

// ---------------------------------------------------------------------------
// Config
// ---------------------------------------------------------------------------

/// Exactly one row, enforced by a CHECK in the migration. C-013 adds prep
/// times; the rest is here.
model RestaurantSettings {
  id            String  @id @default("singleton")
  /// IANA zone. The daily order-number reset, the store-hours gate and every
  /// report bucket derive from this — never UTC, never the process's zone.
  timezone      String
  /// Parts per million. 8.25% = 82_500 (see packages/core/pricing).
  ///
  /// The single rate for every category. Step M2 of the deferred per-line tax
  /// plan (above `model OrderLine`) adds a rate PER category and keeps this
  /// column — it is what every order placed before that migration is explained
  /// by, so the tidy-up that drops it is the defect (C-070).
  taxRatePpm    Int
  /// The manual pause switch (P0-6). Always overrides the other two triggers.
  ordersPaused  Boolean @default(false)
  /// Shown to customers instead of the default while paused.
  pauseMessage  String? @db.VarChar(200)
  /// Auto-pause threshold, summed over OPEN_STATUSES as prep weight (P1-7).
  /// Resumes below it. The default is 60 — 25 orders x 2.4, a little under the
  /// 2.7 the seeded rush actually averages — so it holds the door at roughly
  /// the queue depth the old 25-order count did, while telling a queue of
  /// drinks from a queue of plates.
  maxOpenWeight Int     @default(60)
  /// A "YYYY-MM-DD" in the restaurant's timezone declared closed, or null.
  /// A string, never a Postgres `date` — same reason as `Order.businessDay`.
  closedOnDay   String? @db.Char(10)
  /// New orders stop this many minutes before close (P0-6, default 15).
  cutoffMinutes Int     @default(15)
  /// P0-7. Minutes a ticket takes with an empty queue in front of it.
  prepBaseMinutes Int @default(12)
  /// P0-7. Added per unit of open prep weight — the same OPEN_STATUSES sum the
  /// auto-pause threshold reads, so "busy" means one thing (P1-7).
  prepPerWeightMinutes Int @default(1)

  // --- Loyalty (PRD 7, C-100). Decision 8 of 2026-09-02 lifted the master
  // PRD's Non-Goal; decisions 9 and 10 set the numbers. ---

  /// DEFAULT FALSE, and P0-1 makes that load-bearing: with it off no loyalty
  /// copy renders anywhere, no ledger row is written, and the seeded rush
  /// passes unchanged.
  loyaltyEnabled        Boolean @default(false)
  /// Decision 9: 1 point per dollar of SUBTOTAL. Tax earns nothing.
  pointsPerDollar       Int     @default(1)
  /// Decision 9: 100 points buys the reward.
  rewardThresholdPoints Int     @default(100)
  /// Decision 9: worth $10. Together: 10% back.
  ///
  /// Editable, which is not the same as changeable — moving these once
  /// customers hold balances devalues those balances visibly.
  rewardValueCents      Int     @default(1000)
  /// Decision 10: 365 days of INACTIVITY, counted from `lastActivityAt` and
  /// zeroed by a system `expire` event (P0-5, C-105).
  ///
  /// Two hand-written CHECKs: `loyalty_settings_positive` keeps it above zero
  /// (C-100), and `loyalty_expiry_within_retention` keeps it inside
  /// `retentionDays` (C-105) — so it is impossible to configure a program
  /// whose balances outlive the purchase history that explains them.
  loyaltyExpiryDays     Int     @default(365)

  // --- Retention (PRD 6 P0-4, C-091) ---

  /// How long a customer's IDENTITY is kept after they order: their name,
  /// phone and note. Days, from `placedAt`, and 365 because decision 10 made
  /// the loyalty program this product's retention driver — a punch card that
  /// expires after a year of inactivity needs the purchase history behind it
  /// for at least that long, and nothing else here needs it for more than a
  /// few days.
  ///
  /// It also bounds the LOYALTY MEMBER (C-105): a member whose last activity is
  /// past this window is DELETED, ledger and all, because `displayName` and
  /// `phoneLast4` are the same class of fact as the name on the order.
  ///
  /// It bounds NOTHING else. `seq`, the money, the lines, the option names and
  /// every event are what was sold, and the sweep leaves all of them exactly
  /// as they are so no report moves (`packages/db/retention.ts`).
  retentionDays         Int     @default(365)
}

/// A loyalty member is a PHONE NUMBER (PRD 7 P0-1). No account, no password,
/// no portal — the resolved tokenized-link decision is not re-opened.
///
/// THE PHONE IS NEVER STORED HERE. `phoneDigest` is an HMAC-SHA256 of the
/// normalised number under a pepper held in the ENVIRONMENT, so a dump of this
/// table is not a customer list. `Order.customerPhone` still holds the number
/// in clear and is unchanged — a different fact with a different retention
/// story, deleted by PRD 6's forget path.
model LoyaltyMember {
  id             String         @id @default(uuid())
  phoneDigest    String         @unique
  /// In clear, and only four digits: "the one ending 2233" is what a person
  /// can confirm out loud. Four digits is not an identifier.
  phoneLast4     String         @db.VarChar(4)
  /// Copied at enrolment, like every other snapshot here.
  displayName    String         @db.VarChar(40)
  enrolledAt     DateTime       @db.Timestamptz(3)
  /// What expiry counts from (P0-5). Moved by an earn or a redeem, never by
  /// somebody merely looking the member up — and never by the expiry itself,
  /// or an expired balance would keep resetting the clock that deletes it.
  lastActivityAt DateTime       @db.Timestamptz(3)
  events         LoyaltyEvent[]
}

enum LoyaltyEventKind {
  /// Points for food bought and collected. Positive.
  earn
  /// A reward spent at the counter. Negative, and the only kind carrying money.
  redeem
  /// A staff correction, either direction, never zero.
  adjust
  /// The system zeroing an inactive balance. Negative.
  expire
}

/// The ledger (PRD 7 P0-2). Append-only for UPDATE; DELETE is deliberately
/// permitted, because P0-5's forget path is a real delete and the member
/// Cascade is how it reaches these rows.
model LoyaltyEvent {
  id          String           @id @default(uuid())
  memberId    String
  /// The one Cascade in this model, and the reason the forget can be real: a
  /// balance is an entitlement held for the customer, not a financial record.
  member      LoyaltyMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  /// Null on an `expire`, which is written against no order.
  orderId     String?
  /// `Restrict`: an order outlives every ledger row pointing at it.
  order       Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  at          DateTime         @db.Timestamptz(3)
  kind        LoyaltyEventKind
  /// SIGNED, unlike `OrderEvent.amountCents`. A ledger's direction is its sign
  /// because the balance is a plain sum; money's direction is its KIND because
  /// a balance trusting a sign could not tell a refund from a negative
  /// payment. A CHECK ties the sign to the kind.
  points      Int
  /// What the reward was worth. Non-null exactly on `redeem` — the money
  /// itself lives on `OrderEvent` as an `adjustment`, and this is the ledger's
  /// own copy so the two reconcile to the cent.
  amountCents Int?
  reason      String?
  /// Who corrected it (C-086). `Restrict`: attribution outlives the ledger.
  staffId     String?
  staff       StaffMember?     @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([memberId, at])
  @@index([orderId])
  @@index([staffId])
}

/// One row per day the restaurant is OPEN (P0-6). A missing day is a closed
/// day: a week is configured by listing what opens, so a deleted row can never
/// leave a door open. `dayOfWeek` is the primary key, so a day cannot have two
/// conflicting windows — split lunch/dinner service is a recorded ceiling, not
/// an accident waiting to happen.
model StoreHours {
  /// 0 = Sunday, matching `restaurantClock`.
  dayOfWeek   Int @id
  /// Local wall-clock minutes since midnight, 0–1439.
  openMinute  Int
  /// Local wall-clock minutes since midnight. Must be after `openMinute`.
  closeMinute Int
}
