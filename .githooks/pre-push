#!/bin/sh
# CI is blocked on GitHub Actions billing (every run since C-029 dies in ~3s),
# so both halves of it run here instead:
#   ci:local — a database built from nothing, the hand-written invariants, the
#              drift check, and the unit suite under two hostile timezones
#   gate     — lint, typecheck, unit, production build, e2e
# `git push --no-verify` skips them deliberately (docs-only commits).
# Delete this hook once CI actually runs — the gate belongs in CI, not here.
set -e
echo "pre-push: ci:local, then npm run gate (CI is billing-blocked; --no-verify to skip)"
npm run ci:local
npm run gate
