node_modules/
.next/
.env
# every local env file, including the gitignored .env.production.local that
# holds the Neon URLs for `db:migrate:prod` (C-045).
.env*.local
.env.test
*.tsbuildinfo
test-results/
playwright-report/
.vercel/
# Local session state. Note `.claude/*` and not `.claude/` — git will not
# re-include anything inside an excluded *directory*, so excluding the entries
# is what lets the two negations below take effect.
.claude/*
# Repo content rather than per-machine state: the shared skills and the project
# permission allowlist. A skill that is not committed does not exist in a remote
# session's fresh clone. settings.local.json stays ignored.
!.claude/skills/
!.claude/settings.json

# Built portfolio page: 1.1MB of inlined screenshots, rebuilt by docs/portfolio/build.mjs
docs/portfolio/countertop.html

# Minted by e2e/global-setup.ts from STAFF_PASSCODE (C-037)
apps/web/e2e/.staff-auth.json

# Auto-generated by Next.js on every dev/build (agentRules) — this repo's real
# instructions are the root CLAUDE.md; these are regenerated noise, not content.
apps/web/AGENTS.md
apps/web/CLAUDE.md
